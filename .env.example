# Backend base URL (no trailing slash). Inlined at `npm run build` time.
# Local:
VITE_SIMULATION_API_URL=http://localhost:8000

# Hosted demo (must be HTTPS if the front end is HTTPS):
# VITE_SIMULATION_API_URL=https://your-api.onrender.com

# Optional runtime override without rebuilding — set in the host page before mount:
#   window.__HALLSIM_API_URL__ = "https://your-api.onrender.com";
